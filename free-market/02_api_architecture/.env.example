# =====================================================
# Environment Variables - نظام الشحن
# Shipping System Environment Configuration
# =====================================================

# انسخ هذا الملف إلى .env وعدل القيم

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipping_system
DB_USER=shipping_user
DB_PASSWORD=shipping_pass123

# =====================================================
# ERPNEXT CONFIGURATION
# =====================================================
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=your_erpnext_api_key_here
ERPNEXT_API_SECRET=your_erpnext_api_secret_here
ERPNEXT_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
ERPNEXT_DOCTYPE_PREFIX=Shipping-
MARKET_INTEGRATION_KEY=shared-server-only-key-change-in-production

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
APP_NAME=Shipping System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
FLASK_ENV=development
AUTO_CREATE_TABLES=false

# Server
HOST=0.0.0.0
PORT=5000

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =====================================================
# CORS
# =====================================================
CORS_ORIGINS=*

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=app.log