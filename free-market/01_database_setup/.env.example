# =====================================================
# Environment Variables - نظام الشحن
# Shipping System Environment Configuration
# =====================================================

# انسخ هذا الملف إلى .env وعدل القيم

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipping_system
DB_USER=shipping_user
DB_PASSWORD=shipping_pass123

# =====================================================
# ERPNEXT CONFIGURATION
# =====================================================
ERPNEXT_URL=http://localhost:8000
ERPNEXT_API_KEY=your_erpnext_api_key_here
ERPNEXT_API_SECRET=your_erpnext_api_secret_here
ERPNEXT_DOCTYPE_PREFIX=Shipping-

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
APP_NAME=Shipping System
APP_VERSION=1.0.0
APP_ENV=development  # development, production
DEBUG=True

# Server
HOST=0.0.0.0
PORT=5000

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# =====================================================
# CONTAINER TRACKING APIs (Optional)
# =====================================================
# COSCO Tracking API
COSCO_API_KEY=
COSCO_API_URL=https://api.coscoshipping.com

# Maersk Tracking API  
MAERSK_API_KEY=
MAERSK_API_URL=https://api.maersk.com

# =====================================================
# EMAIL CONFIGURATION (Optional)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@shipping.com

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=app.log

# =====================================================
# CORS
# =====================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173