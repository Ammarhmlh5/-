# =====================================================
# Environment Variables - السوق الحرة (Marketplace)
# Marketplace Environment Configuration
# =====================================================

# انسخ هذا الملف إلى .env وعدل القيم

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Application
APP_NAME=Free Market
APP_VERSION=1.0.0
APP_ENV=development

# Database
# PostgreSQL: postgresql+psycopg://USER:PASS@HOST:PORT/DB
# PostgreSQL
DATABASE_URL=postgresql+psycopg://market_user:marketpass2026@localhost:5433/shipping_marketplace

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# FX (CNY -> USD) — default rate used when no cached rate is available
DEFAULT_FX_CNY_TO_USD=0.14

# Server-side integration credential with the OP-03 gateway (never sent to clients)
MARKET_ERP_KEY=
MARKET_ERP_SECRET=

# Temporary direct ERPNext endpoint for development when OP-03 is unavailable
ERPNEXT_URL=http://localhost:8080
ERPNEXT_WEBHOOK_SECRET=generate-a-long-random-webhook-secret

# OP-03 Integration Gateway base URL
OP03_GATEWAY_URL=http://localhost:8081

# CORS
CORS_ORIGINS=*

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
